# Domains (must share a parent domain, e.g. *.example.com, so Tinyauth's
# session cookie applies to both Tinyauth and Synkban)
SYNKBAN_DOMAIN=synkban.example.com
TINYAUTH_DOMAIN=auth.example.com

# Email for Let's Encrypt TLS certificates
ACME_EMAIL=you@example.com

# Generate a user:hash pair with:
#   docker run --rm ghcr.io/tinyauthapp/tinyauth:v5 user create --interactive
# Note: escape any `$` in the bcrypt hash as `$$` in docker compose env files,
# or pass it via .env as single-quoted/raw depending on your compose version.
TINYAUTH_USERS=admin:$$2a$$10$$replace-with-bcrypt-hash

# Session cookie lifetime in seconds (default: 31536000 = 1 year)
TINYAUTH_SESSION_EXPIRY=31536000

# Host directories for Synkban boards and config (owned by UID 10001 in container)
SYNKBAN_HOST_DATA_DIR=./data
SYNKBAN_HOST_CONFIG_DIR=./config

# Image tag to pull from ghcr.io/waschmittel/synkban
SYNKBAN_IMAGE_TAG=latest
